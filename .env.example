# Copy to .env and replace every value. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_DB=spps
POSTGRES_USER=spps
POSTGRES_PASSWORD=change-me-strong-db-password
SECRET_KEY=change-me-flask-secret
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars
JWT_EXPIRES_HOURS=8
CORS_ORIGINS=http://localhost

# Image coordinates (used by docker compose and scripts/deploy.sh)
REGISTRY=docker.io/your-dockerhub-user
IMAGE_TAG=latest
FRONTEND_PORT=80
